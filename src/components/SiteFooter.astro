---
import snapshot from "../../data/api/v1/current.json";

const links = [
  ["/", "Catalog"],
  ["/leaderboard/", "Leaderboard"],
  ["/memory/", "Memory"],
  ["/preservation/", "Preservation"],
  ["/data/api/v1/current.json", "API index"],
  ["https://github.com/poggit-archive/poggit-archive.github.io", "Site source ↗"],
];
---
<footer class="site-footer">
  <p class="footer-meta">Independent community archive<span class="footer-snapshot">Metadata &amp; downloads: <time datetime={snapshot.captured_at}>{snapshot.captured_at.slice(0, 10)}</time> snapshot.</span></p>
  <nav aria-label="Archive links">
    {links.map(([href, label]) => <a href={href} aria-current={Astro.url.pathname === href ? "page" : undefined} target={href.startsWith("https:") ? "_blank" : undefined} rel={href.startsWith("https:") ? "noreferrer" : undefined}>{label}</a>)}
  </nav>
</footer>
