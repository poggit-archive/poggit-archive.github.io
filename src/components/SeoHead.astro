---
interface Props {
  title: string;
  description: string;
  path: string;
  collection?: boolean;
  homePage?: boolean;
}

const {
  title,
  description,
  path,
  collection = false,
  homePage = false,
} = Astro.props;

const siteOrigin = Astro.site?.origin ?? "https://poggit-archive.github.io";
const siteRoot = new URL("/", siteOrigin).href;
const canonicalUrl = new URL(path, siteRoot).href;
const logoUrl = new URL("/android-chrome-512x512.png", siteRoot).href;
const websiteId = `${siteRoot}#website`;

const graph = [
  ...(homePage
    ? [
        {
          "@type": "WebSite",
          "@id": websiteId,
          url: siteRoot,
          name: "Poggit Archive - Plugins & Virions",
          alternateName: "Poggit Archive",
          inLanguage: "en",
        },
      ]
    : []),
  {
    "@type": collection ? "CollectionPage" : "WebPage",
    url: canonicalUrl,
    inLanguage: "en",
  },
];
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graph,
}).replace(/</g, "\\u003c");
---

<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content="index,follow,max-image-preview:large">
{import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'">}
<meta name="theme-color" content="#ffffff">
<script is:inline src="/theme.js?v=1"></script>
<script is:inline src="/loading.js?v=virions-1"></script>
<link rel="canonical" href={canonicalUrl}>
{homePage && <meta name="google-site-verification" content="7wr__v7tRKs9GHzQaNq6RK9Sw6NNRHUYVORhu4MASbk">}

<meta property="og:type" content="website">
<meta property="og:site_name" content="Poggit Archive - Plugins &amp; Virions">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalUrl}>
<meta property="og:image" content={logoUrl}>
<meta property="og:image:alt" content="Poggit Archive logo">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="512">
<meta property="og:image:height" content="512">

<meta name="twitter:card" content="summary">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={logoUrl}>
<meta name="twitter:image:alt" content="Poggit Archive logo">

<script type="application/ld+json" set:html={structuredData}></script>
