---
import SeoHead from "../../components/SeoHead.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getVirionCatalog, virionPath, virionView, virionAuthorPath } from "../../lib/virion-details.mjs";
import { date, number, list, text } from "../../lib/plugin-details.mjs";
export function getStaticPaths() {
  return getVirionCatalog().items.map((item) => ({ params: { path: virionPath(item).slice(9, -1) }, props: { id: item.id } }));
}
const catalog = getVirionCatalog();
const item = catalog.items.find((item) => item.id === Astro.props.id);
const view = virionView(item, catalog);
const { record, manifest, composer, artifact, source } = view;
const repository = `https://github.com/${item.owner}/${item.repo}`;
const sourceRepository = source?.source_repository_used || source?.source_repo;
const namespace = view.namespace;
const poggitExample = `projects:\n  YourPlugin:\n    libs:\n      - src: ${item.owner}/${item.repo}/${item.project}\n        version: ${JSON.stringify(item.version || "*")}`;
const requirements = Object.entries(composer.require || {});
const libraries = record.poggit_libraries || [];
const hasChangelog = Boolean(record.documents.changelog);
const versionNote = item.version ? `Catalog version ${item.version}` : "The catalog did not record a version number.";
---
<!doctype html><html lang="en"><head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#ffffff">
  <SeoHead title={`${item.name} - Virion - Poggit Archive`} description={view.description} path={virionPath(item)} />
  <link rel="icon" href="/favicon-32x32.png"><link rel="stylesheet" href="/styles.css?v=api-1"><link rel="stylesheet" href="/plugin-details.css?v=api-1">
  <script is:inline src="/plugin-details.js?v=api-1" defer></script><script is:inline src="/virion-details.js?v=virions-1" defer></script>
</head><body><SiteHeader />
<main class="plugin-detail" data-virion-id={item.id} data-virion-documents={catalog.documentUrl}>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/?type=virions">Virions</a><span aria-hidden="true">/</span><span>{item.name}</span></nav>
  <section class="plugin-hero" aria-labelledby="virion-title"><img class="detail-icon" src="/assets/virion.svg" alt="" width="80" height="80"><div class="hero-copy"><p class="eyebrow">PocketMine-MP virion</p><h1 id="virion-title">{item.name}</h1><p class="detail-author">by <a href={virionAuthorPath(item.owner)}>{item.owner}</a></p><p class="detail-tagline">{view.description}</p></div></section>
  <div class="release-toolbar"><span title={view.versionSource || "No version was preserved"}>Version <strong>{view.version}</strong></span><span class="toolbar-count">{number(item.used_by_projects)} projects use this</span><span class="license-label">{view.license}</span>{artifact && <span class="release-flag">{artifact.label}</span>}{source && <span class="release-flag">{source.label}</span>}</div>
  <nav class="detail-tabs" aria-label="Virion sections"><a href="#overview">Overview</a><a href="#usage">Usage</a><a href="#dependencies">Dependencies</a><a href="#used-by">Used by <span>{view.users.length}</span></a><a href="#snapshot">Snapshot</a>{hasChangelog && <a href="#changelog">Changelog</a>}<a href="#license">License</a></nav>
  <div class="detail-layout"><div class="detail-main">
    <section id="overview" class="detail-section"><div class="section-heading"><h2>Overview</h2><span>Preserved source documentation</span></div><p class="section-note">{source?.note || "Source files have not been recovered for this entry."}</p><div class="archived-document" data-virion-document="readme"><p class="empty-detail">{record.documents.readme ? "The README is available in the preserved source ZIP and loads here with JavaScript." : "No README was found in the preserved source."}</p>{source && <a class="text-link" href={source.url}>Download source ZIP</a>}</div></section>
    <section id="usage" class="detail-section"><h2>Usage</h2><p>A virion is a library bundled into a plugin. Use a compatible virion compiler to shade it into your plugin; copying this library PHAR into the server's plugins folder does not install a standalone plugin.</p><h3>Historical Poggit CI configuration</h3><p class="section-note">Example for <code>.poggit.yml</code>. Poggit is an optional external build service; the archive does not run builds. {versionNote}</p><pre class="usage-code">{poggitExample}</pre>{composer.name && <><h3>Composer package</h3><code>{composer.name}</code><p class="section-note">Use the preserved README for package constraints and a compatible virion compiler. Ordinary Composer installation alone does not shade the library.</p></>}<h3>Namespace</h3><code>{namespace}</code></section>
    <section id="dependencies" class="detail-section"><h2>Dependencies</h2><p class="section-note">Declarations from the preserved source revision. Runtime requirements may also be documented in the README.</p><h3>Poggit libraries</h3>{libraries.length ? <ul class="dependency-list">{libraries.map((dependency) => <li><strong>{dependency.src || text(dependency)}</strong><span>{dependency.version || "*"}</span></li>)}</ul> : <p class="empty-detail">No library declarations were found in the preserved Poggit project configuration.</p>}<h3>Composer requirements</h3>{requirements.length ? <ul class="dependency-list">{requirements.map(([name, version]) => <li><strong>{name}</strong><span>{text(version)}</span></li>)}</ul> : <p class="empty-detail">No Composer requirements were preserved.</p>}</section>
    <section id="used-by" class="detail-section"><h2>Used by archived plugins <span>{view.users.length}</span></h2><p class="section-note">Matched by repository and project in the captured plugin dependency records. This can differ from Poggit's catalog count of {number(item.used_by_projects)} projects. A reference does not establish compatibility with this particular PHAR.</p><div data-virion-document="users"><p class="empty-detail">{view.users.length ? "The preserved dependency list loads here with JavaScript." : "No matching plugin dependency records were preserved."}</p></div></section>
    <section id="snapshot" class="detail-section"><h2>Preserved snapshot</h2><p>{versionNote} Only this catalog entry was captured; a complete version history is unavailable.</p><dl class="compact-facts"><dt>PHAR version</dt><dd>{view.pharVersion || "Not preserved"}</dd><dt>Namespace</dt><dd><code>{namespace}</code></dd><dt>Manifest from</dt><dd>{record.manifest_origin?.replaceAll("_", " ") || "Not preserved"}</dd></dl><h3>Manifest and configuration</h3><div data-virion-document="files"><p class="empty-detail">{record.manifest_document ? "Original manifest and configuration load here with JavaScript." : "No manifest was recovered for this entry."}</p></div></section>
    {hasChangelog && <section id="changelog" class="detail-section"><h2>Changelog</h2><p class="section-note">Document from the preserved source revision, not a complete Poggit release history.</p><div class="archived-document" data-virion-document="changelog"><p class="empty-detail">The preserved changelog loads here with JavaScript.</p></div></section>}
    <section id="license" class="detail-section"><h2>License <span>{view.license}</span></h2><div data-virion-document="licenses"><p class="empty-detail">{record.licenses.length ? "Full license documents load here with JavaScript and remain in the source ZIP." : "No nonempty license document was preserved. No replacement license has been assigned."}</p>{source && <a class="text-link" href={source.url}>Download source ZIP</a>}</div></section>
    <p class="media-preservation-note"><a href="/preservation/">Documents and available images are served from preserved copies.</a><span data-virion-missing-images></span></p>
  </div><aside class="detail-sidebar" aria-label="Virion information">
    <section id="download" class="download-card"><p class="eyebrow">Preserved library</p><h2>{item.name}<span>{view.version}</span></h2>{artifact ? <><a class="primary-download" href={artifact.url} download={`${item.name}-${view.version}.phar`}>{artifact.label}<span aria-hidden="true">↓</span></a><p class="file-size">{number(artifact.bytes)} bytes · {(artifact.bytes / 1024).toFixed(1)} KiB</p>{!artifact.original && <p class="source-note">Reconstructed with {artifact.builder || "VirionTools"} {artifact.builder_version}. The original Poggit PHAR is unavailable.</p>}<a class="artifact-backup" href={artifact.remote_url}>Artifact repository backup ↗</a></> : <p class="empty-detail">PHAR not recovered</p>}{source ? <><a class="source-download" href={source.url}>{source.label}<span aria-hidden="true">↓</span></a><p class="source-note">{source.note}</p></> : <p class="empty-detail">Source ZIP not recovered</p>}<details class="install-help"><summary>How to use</summary><ol><li>Choose a compatible library version and check its dependencies.</li><li>Bundle the library into your plugin with a virion compiler.</li></ol><a class="text-link" href="#usage">View usage details</a></details></section>
    <section class="sidebar-section"><h2>Library details</h2><dl class="release-facts"><dt>Version</dt><dd>{view.version}</dd><dt>Version source</dt><dd>{view.versionSource || "Not preserved"}</dd><dt>Namespace / antigen</dt><dd><code>{namespace}</code></dd><dt>Declared APIs</dt><dd>{view.api}</dd><dt>Last updated (UTC)</dt><dd>{date(Number(item.last_updated))}</dd><dt>Catalog build marker</dt><dd><code>{item.last_build_short_id || "Not recorded"}</code></dd>{manifest.build?.poggitBuildId && <><dt>Preserved PHAR build ID</dt><dd>{manifest.build.poggitBuildId}</dd></>}</dl><p class="section-note">The saved PHAR build can differ from the catalog's last-build marker. API declarations are historical metadata.</p></section>
    <section class="sidebar-section"><h2>Links</h2><ul class="sidebar-links"><li><a href={repository}>Original repository ↗</a></li>{sourceRepository && source?.verified_revision && <li><a href={`https://github.com/${sourceRepository}/tree/${source.verified_revision}`}>Preserved source revision ↗</a></li>}<li><a href={`${repository}/issues`}>Issues &amp; support ↗</a></li><li><a href={`/data/snapshots/${catalog.capture.snapshot_id}/virions.json`}>Preserved catalog metadata</a></li></ul></section>
    <details class="sidebar-section technical-details"><summary>Archive identity &amp; checksums</summary><dl class="release-facts"><dt>Catalog ID</dt><dd><code>{item.id}</code></dd>{source && <><dt>Source revision</dt><dd><code>{source.verified_revision || "Not established"}</code></dd><dt>Source SHA-256</dt><dd><code>{source.sha256}</code></dd></>}{artifact && <><dt>PHAR SHA-256</dt><dd><code>{artifact.sha256}</code></dd></>}</dl></details>
  </aside></div>
</main><SiteFooter /></body></html>
