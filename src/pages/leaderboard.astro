<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#ffffff">
    <meta name="description" content="A leaderboard of plugin authors from the Poggit Archive snapshot.">
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
    <link rel="manifest" href="/site.webmanifest">
    <title>Leaderboard - Poggit Archive</title>
    <link rel="stylesheet" href="/styles.css?v=catalog-icons-mono-1">
    <script is:inline src="/leaderboard.js" defer></script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-brand">
        <img class="site-brand-icon" src="/android-chrome-192x192.png" alt="" width="40" height="40">
        <div class="header-intro">
          <h1><a href="/">Poggit Archive - Plugins &amp; Virions</a></h1>
          <p>A read-only archive of entries listed on Poggit. This independent project preserves available metadata and files.</p>
        </div>
      </div>
    </header>

    <main>
      <section class="leaderboard" aria-labelledby="leaderboard-title">
        <div class="leaderboard-heading">
          <div>
            <h2 id="leaderboard-title">Leaderboard</h2>
            <p>Plugin authors ranked by archived downloads</p>
          </div>
          <label class="leaderboard-search">
            <span class="sr-only">Search authors</span>
            <input id="leaderboard-search" type="search" placeholder="Search authors" autocomplete="off" aria-label="Search authors">
          </label>
        </div>

        <p id="leaderboard-count" class="results-count" aria-live="polite">Loading authors</p>
        <div id="leaderboard-error" class="error hidden" role="alert"></div>
        <div class="leaderboard-table-wrap">
          <table class="leaderboard-table">
            <thead>
              <tr>
                <th scope="col" class="leaderboard-rank">Rank</th>
                <th scope="col" data-sort="author" aria-sort="none"><button type="button">Author</button></th>
                <th scope="col" data-sort="plugins" aria-sort="none"><button type="button">Plugins</button></th>
                <th scope="col" data-sort="total" aria-sort="descending"><button type="button">Total downloads</button></th>
                <th scope="col" data-sort="average" aria-sort="none"><button type="button">Downloads per plugin</button></th>
              </tr>
            </thead>
            <tbody id="leaderboard-rows"></tbody>
          </table>
        </div>
        <nav class="pagination" aria-label="Leaderboard pages">
          <div id="leaderboard-pages" class="page-list"></div>
          <label class="page-jump">
            <span class="sr-only">Go to page</span>
            <input id="leaderboard-page-input" type="number" min="1" step="1" inputmode="numeric" placeholder="Page" aria-label="Go to page" disabled>
          </label>
        </nav>
      </section>
    </main>

    <footer class="site-footer">
      <a href="/">Plugins &amp; Virions</a>
      <nav aria-label="Archive links">
        <a href="/memory/">Memory</a>
        <a href="/data/api/v1/current.json" target="_blank" rel="noreferrer">API index</a>
        <a href="https://github.com/poggit-archive" target="_blank" rel="noreferrer">GitHub</a>
        <a href="https://poggit.pmmp.io/">Poggit</a>
      </nav>
    </footer>
  </body>
</html>
