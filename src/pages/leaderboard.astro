---
import SeoHead from "../components/SeoHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const title = "Leaderboard - Poggit Archive";
const description = "Plugin authors ranked by the combined archived downloads of their Poggit releases.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <SeoHead title={title} description={description} path="/leaderboard/" collection={true} />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
    <link rel="manifest" href="/site.webmanifest">
    <link rel="stylesheet" href="/styles.css?v=theme-1">
    <script is:inline src="/leaderboard.js?v=author-links-1" defer></script>
  </head>
  <body>
    <SiteHeader />

    <main>
      <section class="leaderboard" aria-labelledby="leaderboard-title">
        <div class="leaderboard-heading">
          <div>
            <h1 id="leaderboard-title">Leaderboard</h1>
            <p>Plugin authors ranked by archived downloads</p>
          </div>
          <label class="leaderboard-search">
            <span class="sr-only">Search authors</span>
            <input id="leaderboard-search" type="search" placeholder="Search authors" autocomplete="off" aria-label="Search authors">
          </label>
        </div>

        <p id="leaderboard-count" class="results-count" aria-live="polite">Loading authors</p>
        <div id="leaderboard-error" class="error hidden" role="alert"></div>
        <div class="leaderboard-table-wrap">
          <table class="leaderboard-table">
            <thead>
              <tr>
                <th scope="col" class="leaderboard-rank">Rank</th>
                <th scope="col" data-sort="author" aria-sort="none"><button type="button">Author</button></th>
                <th scope="col" data-sort="plugins" aria-sort="none"><button type="button">Plugins</button></th>
                <th scope="col" data-sort="total" aria-sort="descending"><button type="button">Total downloads</button></th>
                <th scope="col" data-sort="average" aria-sort="none"><button type="button">Downloads per plugin</button></th>
              </tr>
            </thead>
            <tbody id="leaderboard-rows" aria-busy="true">
              {Array.from({ length: 8 }, () => (
                <tr class="skeleton-table-row" aria-hidden="true">
                  <td><span class="skeleton-block skeleton-cell skeleton-rank"></span></td>
                  <td><span class="skeleton-block skeleton-cell skeleton-author"></span></td>
                  <td><span class="skeleton-block skeleton-cell skeleton-number"></span></td>
                  <td><span class="skeleton-block skeleton-cell skeleton-total"></span></td>
                  <td><span class="skeleton-block skeleton-cell skeleton-average"></span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <nav class="pagination" aria-label="Leaderboard pages">
          <div id="leaderboard-pages" class="page-list"></div>
          <label class="page-jump">
            <span class="sr-only">Go to page</span>
            <input id="leaderboard-page-input" type="number" min="1" step="1" inputmode="numeric" placeholder="Page" aria-label="Go to page" disabled>
          </label>
        </nav>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
