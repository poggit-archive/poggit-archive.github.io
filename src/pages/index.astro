<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#ffffff">
    <meta name="description" content="An independent archive of PocketMine-MP plugins and virions listed on Poggit.">
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
    <link rel="manifest" href="/site.webmanifest">
    <title>Poggit Archive - Plugins &amp; Virions</title>
    <link rel="stylesheet" href="/styles.css?v=api-filter-custom-1">
    <script is:inline src="/app.js?v=api-filter-custom-1" defer></script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-brand">
        <a class="site-brand-home" href="/" aria-label="Poggit Archive home">
          <img class="site-brand-icon" src="/android-chrome-192x192.png" alt="" width="40" height="40">
        </a>
        <div class="header-intro">
          <h1 id="page-title">Poggit Archive - Plugins &amp; Virions</h1>
          <p>A read-only archive of entries listed on Poggit. This independent project preserves available metadata and files.</p>
        </div>
      </div>
    </header>

    <main>
      <section class="catalog" aria-label="Catalog">
        <div class="catalog-tools">
          <div class="tabs" role="tablist" aria-label="Catalog type">
            <button class="tab active" id="tab-plugins" role="tab" aria-selected="true" aria-controls="results" data-kind="plugins">Plugins <span id="plugins-tab-count"></span></button>
            <button class="tab" id="tab-virions" role="tab" aria-selected="false" aria-controls="results" data-kind="virions">Virions <span id="virions-tab-count"></span></button>
          </div>
          <div class="search-controls">
            <label class="search-field">
              <span class="sr-only">Search releases</span>
              <input id="search" type="search" placeholder="Search Releases" autocomplete="off" aria-label="Search releases">
            </label>
            <div id="search-mode-control" class="search-mode">
              <button id="search-mode-trigger" class="search-mode-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="search-mode-menu">
                <span id="search-mode-current">Plugin</span>
                <span class="search-mode-caret" aria-hidden="true"></span>
              </button>
              <div id="search-mode-menu" class="search-mode-menu" role="listbox" aria-label="Search by" hidden>
                <button class="search-mode-option" type="button" role="option" aria-selected="true" data-search-field="name">Plugin</button>
                <button class="search-mode-option" type="button" role="option" aria-selected="false" data-search-field="author">Author</button>
              </div>
            </div>
            <div id="api-filter-control" class="api-filter">
              <span class="sr-only">Filter by API version</span>
              <button id="api-filter-trigger" class="api-filter-trigger" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="api-filter-menu" aria-label="Filter by API version: All APIs">
                <span id="api-filter-current">All APIs</span>
                <span class="search-mode-caret" aria-hidden="true"></span>
              </button>
              <div id="api-filter-menu" class="api-filter-menu" role="listbox" aria-label="Filter by API version" hidden>
                <button class="api-filter-option" type="button" role="option" aria-selected="true" data-api-version="">All APIs</button>
              </div>
            </div>
          </div>
        </div>

        <p id="results-count" class="results-count" aria-live="polite">Loading catalog</p>
        <div id="error" class="error hidden" role="alert"></div>
        <div id="results" class="results" role="tabpanel" aria-labelledby="tab-plugins"></div>
        <nav class="pagination" aria-label="Catalog pages">
          <div id="page-list" class="page-list"></div>
          <label class="page-jump">
            <span class="sr-only">Go to page</span>
            <input id="page-input" type="number" min="1" step="1" inputmode="numeric" placeholder="Page" aria-label="Go to page" disabled>
          </label>
        </nav>
      </section>
    </main>

    <footer class="site-footer">
      <span>Independent community archive</span>
      <nav aria-label="Archive links">
        <a href="/leaderboard/">Leaderboard</a>
        <a href="/memory/">Memory</a>
        <a href="/data/api/v1/current.json" target="_blank" rel="noreferrer">API index</a>
        <a href="https://github.com/poggit-archive" target="_blank" rel="noreferrer">GitHub</a>
        <a href="https://poggit.pmmp.io/" target="_blank" rel="noreferrer">Poggit</a>
      </nav>
    </footer>
  </body>
</html>
