<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#ffffff">
    <meta name="description" content="An independent archive of PocketMine-MP plugins and virions listed on Poggit.">
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
    <link rel="manifest" href="/site.webmanifest">
    <title>Poggit Archive - Plugins &amp; Virions</title>
    <link rel="stylesheet" href="/styles.css">
    <script is:inline src="/app.js" defer></script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-intro">
        <h1 id="page-title">Poggit Archive - Plugins &amp; Virions</h1>
        <p>A read-only archive of entries listed on Poggit. This independent project preserves available metadata and files.</p>
      </div>
    </header>

    <main>
      <section class="catalog" aria-label="Catalog">
        <div class="catalog-tools">
          <div class="tabs" role="tablist" aria-label="Catalog type">
            <button class="tab active" id="tab-plugins" role="tab" aria-selected="true" aria-controls="results" data-kind="plugins">Plugins <span id="plugins-tab-count"></span></button>
            <button class="tab" id="tab-virions" role="tab" aria-selected="false" aria-controls="results" data-kind="virions">Virions <span id="virions-tab-count"></span></button>
          </div>
          <label class="search-field">
            <span class="sr-only">Search by name, author or description</span>
            <input id="search" type="search" placeholder="Search by name, author or description" autocomplete="off" aria-label="Search by name, author or description">
          </label>
        </div>

        <p id="results-count" class="results-count" aria-live="polite">Loading catalog</p>
        <div id="error" class="error hidden" role="alert"></div>
        <div id="results" class="results" role="tabpanel" aria-labelledby="tab-plugins"></div>
        <nav class="pagination" aria-label="Catalog pages">
          <button id="prev-page" class="page-button" type="button" disabled>Previous</button>
          <span id="page-label">Page 1</span>
          <button id="next-page" class="page-button" type="button" disabled>Next</button>
        </nav>
      </section>
    </main>

    <footer class="site-footer">
      <span>Independent community archive</span>
      <nav aria-label="Archive links">
        <a href="/data/api/v1/current.json" target="_blank" rel="noreferrer">API index</a>
        <a href="https://github.com/poggit-archive" target="_blank" rel="noreferrer">GitHub</a>
        <a href="https://poggit.pmmp.io/" target="_blank" rel="noreferrer">Poggit</a>
      </nav>
    </footer>
  </body>
</html>
